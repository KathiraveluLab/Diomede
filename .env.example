# Copy this file to .env and fill in real values before running.
# Never commit the actual .env file.

# --- Orthanc account ---
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=CHANGE_IN_PRODUCTION

# --- src/simulator/send_dicom_native.py, send_dicom_rest.py defaults ---
# (kept separate from the REGION*/NODE_* keys below -- these two scripts are
# standalone manual-test tools, not tied to a specific region)
ORTHANC_DICOM_HOST=localhost
ORTHANC_CALLED_AET=Orthanc_US
ORTHANC_CALLING_AET=Simulator
ORTHANC_BASE_URL=https://localhost:8042

# --- FastAPI key ---
ORCHESTRATOR_API_KEY=CHANGE_IN_PRODUCTION

# --- Logging ---
LOG_LEVEL=INFO

# --- Region identity ---
REGION1=us
REGION2=eu
REGION3=asia
REGION4=af

REGION1_NAME=us-east1
REGION2_NAME=eu-west1
REGION3_NAME=asia-northeast1
REGION4_NAME=af-south1

REGION1_AET=Orthanc_US
REGION2_AET=Orthanc_EU
REGION3_AET=Orthanc_ASIA
REGION4_AET=Orthanc_AF
EDGE_AGENT1_AET=Orthanc_Edge

EDGE_AGENT1=agent-001
ORCHESTRATOR=orchestrator

# ---- container/service names on the docker network ---
REGION1_HOST=orthanc-${REGION1}
REGION2_HOST=orthanc-${REGION2}
REGION3_HOST=orthanc-${REGION3}
REGION4_HOST=orthanc-${REGION4}
EDGE_AGENT1_HOST=agent-001
ORCHESTRATOR_HOST=${ORCHESTRATOR}

# Container-internal ports: identical for every Orthanc node because each
# only ever listens on its own localhost inside its own container
ORTHANC_HTTPS_PORT=8042
ORTHANC_DICOM_PORT=4242
ORCHESTRATOR_PORT=8000
REDIS_PORT=6379

# a container reaching its own co-located Orthanc.
NODE_INT_BASE=https://localhost:${ORTHANC_HTTPS_PORT}

# container-to-container base URLs, used by the orchestrator
# daemon and the edge forwarder to reach the four cloud nodes.
NODE_US_BASE=https://${REGION1_HOST}:${ORTHANC_HTTPS_PORT}
NODE_EU_BASE=https://${REGION2_HOST}:${ORTHANC_HTTPS_PORT}
NODE_ASIA_BASE=https://${REGION3_HOST}:${ORTHANC_HTTPS_PORT}
NODE_AF_BASE=https://${REGION4_HOST}:${ORTHANC_HTTPS_PORT}
ORCHESTRATOR_BASE=https://${ORCHESTRATOR_HOST}:${ORCHESTRATOR_PORT}

NODE_US_USER=${ORTHANC_USER}
NODE_US_PASS=${ORTHANC_PASSWORD}
NODE_EU_USER=${ORTHANC_USER}
NODE_EU_PASS=${ORTHANC_PASSWORD}
NODE_ASIA_USER=${ORTHANC_USER}
NODE_ASIA_PASS=${ORTHANC_PASSWORD}
NODE_AF_USER=${ORTHANC_USER}
NODE_AF_PASS=${ORTHANC_PASSWORD}
EDGE_USER=${ORTHANC_USER}
EDGE_PASS=${ORTHANC_PASSWORD}

# --- Exposed host/port for anything running outside docker
# (tests, src/benchmark scripts, a browser).
REGION1_FQDN=localhost
REGION2_FQDN=localhost
REGION3_FQDN=localhost
REGION4_FQDN=localhost
EDGE_AGENT1_FQDN=localhost
ORCHESTRATOR_FQDN=localhost

REGION1_HTTPS_PORT=8042
REGION2_HTTPS_PORT=8043
REGION3_HTTPS_PORT=8044
REGION4_HTTPS_PORT=8045
EDGE_AGENT1_HTTPS_PORT=8046
ORCHESTRATOR_HTTPS_PORT=8000

REGION1_DICOM_PORT=4242
REGION2_DICOM_PORT=4243
REGION3_DICOM_PORT=4244
REGION4_DICOM_PORT=4245
EDGE_AGENT1_DICOM_PORT=4246

NODE_US_HTTPS_URL=https://${REGION1_FQDN}:${REGION1_HTTPS_PORT}
NODE_EU_HTTPS_URL=https://${REGION2_FQDN}:${REGION2_HTTPS_PORT}
NODE_ASIA_HTTPS_URL=https://${REGION3_FQDN}:${REGION3_HTTPS_PORT}
NODE_AF_HTTPS_URL=https://${REGION4_FQDN}:${REGION4_HTTPS_PORT}
EDGE_AGENT1_HTTPS_URL=https://${EDGE_AGENT1_FQDN}:${EDGE_AGENT1_HTTPS_PORT}
ORCHESTRATOR_HTTPS_URL=https://${ORCHESTRATOR_FQDN}:${ORCHESTRATOR_HTTPS_PORT}

NODE_US_DICOM_URL=https://${REGION1_FQDN}:${REGION1_DICOM_PORT}
NODE_EU_DICOM_URL=https://${REGION2_FQDN}:${REGION2_DICOM_PORT}
NODE_ASIA_DICOM_URL=https://${REGION3_FQDN}:${REGION3_DICOM_PORT}
NODE_AF_DICOM_URL=https://${REGION4_FQDN}:${REGION4_DICOM_PORT}
EDGE_AGENT1_DICOM_URL=https://${EDGE_AGENT1_FQDN}:${EDGE_AGENT1_DICOM_PORT}

# --- Redis (its own service on the docker network) ---
REDIS_HOST=redis
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
REDIS_TTL_S=30

# --- Certs ---
REQUESTS_CA_BUNDLE=/certs/ca.pem
TEST_CLIENT_CERT=certs/diomede-client/client.crt
TEST_CLIENT_KEY=certs/diomede-client/client.key

# --- Polling / timeouts ---
DAEMON_POLL_INTERVAL_S=10
FORWARDER_POLL_INTERVAL_S=5
HTTP_TIMEOUT_S=5
PROBE_INTERVAL_S=3600

# --- Orchestrator scoring weights ---
W_QUEUE=0.5
W_DISK=0.15
W_RTT=0.35
MIN_FREE_MB=500

# --- Load test parameters ---
LOAD_FILE_SIZE_KB=50
LOAD_BURST_COUNT=0
LOAD_MAX_P99_MS=50
LOAD_MAX_FAIL_RATIO=0.005
# standard scanner of 10-50 images per second
LOAD_MIN_INTERVAL=0.02
LOAD_MAX_INTERVAL=0.10
